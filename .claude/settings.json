{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.git/**)",
      "Read(./CLAUDE.local.md)",
      "Read(./outputs/**)",
      "Read(./.venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.DS_Store)",
      "Read(./ocr-go/bin/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.git/**)",
      "Edit(./CLAUDE.local.md)",
      "Edit(./.venv/**)",
      "Edit(./**/__pycache__/**)",
      "Edit(./ocr-go/bin/**)"
    ],
    "allow": [
      "Bash(make help)",
      "Bash(make hooks)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make test-docker)",
      "Bash(make check)",
      "Bash(make status)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(black:*)",
      "Bash(python3 -m black:*)",
      "Bash(mypy:*)",
      "Bash(python3 -m mypy:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(gofmt:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(.claude/scripts/commit.sh:*)",
      "Bash(.claude/scripts/repo.sh:*)",
      "Bash(gh auth status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/scripts/git-guard.mjs\" 2>/dev/null",
            "if": "Bash(git *)",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/scripts/pipeline-hint.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
