# Environment variables for Python-OCR.
# Copy to .env and adjust; docker compose reads it automatically.

# --- OCR engine -----------------------------------------------------------
# Tesseract language code. Combine with "+" (e.g. spa+eng).
OCR_LANG=spa

# Scale factor used when rasterizing PDF pages before OCR.
# Higher values improve accuracy but use more memory and time.
OCR_PDF_ZOOM=2

# Discard detections below this confidence, in the 0-1 range.
OCR_MIN_CONFIDENCE=0

# --- Application ----------------------------------------------------------
# Largest accepted upload, in megabytes.
MAX_UPLOAD_SIZE_MB=25

# Directory where JSON, Markdown, text and annotated images are written.
OUTPUT_DIR=outputs

# --- Server ---------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501

# --- Logging --------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
