#!/usr/bin/env bash
#
# Validates the commit message against Conventional Commits 1.0.0, as specified
# in .github/instructions/commit.instructions.md and the commit-procedure skill.
#
# What this can and cannot do: it checks the shape of a message, never its
# truthfulness. A well-formed subject describing the wrong diff passes here and
# always will. That is why the commit procedure requires reading the subject back
# against the staged diffstat before committing — this hook is the floor, not the
# check.
#
# Install with: make hooks

set -uo pipefail

MSG_FILE=$1

fail() {
    printf '\ncommit-msg: %s\n\n' "$1" >&2
    exit 1
}

# Comments and the diff git appends under --verbose are not part of the message.
message=$(grep -v '^#' "$MSG_FILE" | sed '/^diff --git /,$d')

subject=$(printf '%s\n' "$message" | sed -n '1p')
second_line=$(printf '%s\n' "$message" | sed -n '2p')
body=$(printf '%s\n' "$message" | sed -n '3,$p')

# A merge commit's message is generated by git and is not ours to shape.
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

[ -n "$subject" ] || fail "the message is empty."

# --- Subject --------------------------------------------------------------

TYPES='feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert|improvement'

if ! printf '%s' "$subject" | grep -qE "^($TYPES)(\([a-z0-9-]+\))?!?: .+"; then
    fail "the subject does not follow Conventional Commits 1.0.0.

  Expected:  <type>(<scope>): <description>
  Got:       $subject

  Types:     $(printf '%s' "$TYPES" | tr '|' ' ')
  Scopes:    engine app go tests docker config ci docs agent-config
  Breaking:  put ! before the colon, e.g. feat(go)!: rename bbox to box"
fi

if [ "${#subject}" -gt 72 ]; then
    fail "the subject is ${#subject} characters; keep it to 72 so it survives a narrow log column.

  $subject"
fi

description=${subject#*: }

case "$description" in
    [A-Z]*) fail "the description starts with a capital: \"$description\". Use lowercase." ;;
    *.) fail "the description ends with a period. Drop it." ;;
esac

# --- Body -----------------------------------------------------------------

if [ -n "$second_line" ]; then
    fail "line 2 must be blank. A body starts after one empty line."
fi

# Git reflows nothing, so the line breaks in the file are the ones every reader
# gets. URLs and indented code are exempt: they cannot be wrapped without
# breaking them.
if [ -n "$body" ]; then
    long=$(printf '%s\n' "$body" | grep -nE '.{73,}' | grep -vE ':\s|https?://|^[0-9]+:( {4}|\t)' || true)
    if [ -n "$long" ]; then
        fail "wrap the body at 72 columns. These lines are longer:
$(printf '%s\n' "$long" | sed 's/^/    /')"
    fi
fi

# --- Trailers -------------------------------------------------------------
#
# Attribution is disabled by configuration here; a hand-written trailer would
# credit an account that never touched the work.
if printf '%s\n' "$message" | grep -qiE '^Co-Authored-By:'; then
    fail "remove the Co-Authored-By trailer. Commits here carry no attribution trailer."
fi

exit 0
