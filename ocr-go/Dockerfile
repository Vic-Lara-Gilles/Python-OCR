# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Builder: cgo is required, gosseract binds to the Tesseract C API.
# ---------------------------------------------------------------------------
FROM golang:1.21-alpine AS builder

RUN apk add --no-cache gcc musl-dev tesseract-ocr-dev leptonica-dev

WORKDIR /build

# go.sum is optional: the bracket glob keeps the build working before the
# checksum file has been generated by `go mod tidy`.
COPY go.mod go.su[m] ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o ocr-server ./cmd/server

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM alpine:3.19

RUN apk add --no-cache \
        tesseract-ocr \
        tesseract-ocr-data-spa \
        tesseract-ocr-data-eng \
        leptonica \
        ca-certificates

WORKDIR /app

COPY --from=builder /build/ocr-server ./
COPY --from=builder /build/web ./web

RUN adduser -D -u 1000 appuser \
    && mkdir -p outputs \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./ocr-server"]
